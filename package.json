{
  "name": "polofield",
  "version": "0.0.0",
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "@slack/bolt": "^5.0.0",
    "discord-api-types": "^0.38.54",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.5",
    "html-rewriter-wasm": "^0.4.1",
    "jszip": "^3.10.1",
    "prettier": "^3.9.6",
    "suncalc": "^2.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "private": true,
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "wrangler": "wrangler",
    "generate-types": "wrangler types --env-file=.dev.vars.example --strict-vars=false",
